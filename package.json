{
  "name": "solohq",
  "version": "0.2.3",
  "description": "Cloud-synced dashboard for one-person companies with optional Google sign-in.",
  "type": "module",
  "license": "MIT",
  "author": "zhaolongfei-shareye",
  "keywords": [
    "dashboard",
    "solo",
    "react",
    "vite",
    "tailwindcss",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaolongfei-shareye/SoloHQ.git"
  },
  "homepage": "https://github.com/zhaolongfei-shareye/SoloHQ",
  "bugs": {
    "url": "https://github.com/zhaolongfei-shareye/SoloHQ/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && mkdir -p dist/server && cp server/index.js dist/server/index.js",
    "extension:build": "vite build",
    "extension:zip": "npm run extension:build && cd dist && zip -qr ../SoloHQ-extension.zip .",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
